# 依赖
node_modules/

# 本地测试 / 浏览器临时产物
.tmp/
.chrome-profile/
data/ui-shots/

# 运行时状态：数据源、用户配置、拉取的比赛数据、原始响应快照
# 这些是每台机器各自的本地数据，不入库；首次启动时由 lib/store.js 自动创建
data/sources.json
data/config.json
data/contests/*.rboard.json
data/raw/*.raw.json

# 原子写入的临时文件 / 日志
*.tmp
*.log

# 本地环境变量（可能含 OJ 凭据）
.env
.env.*
!.env.example

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# WorkBuddy 项目元数据与个人工作记录
.workbuddy/
